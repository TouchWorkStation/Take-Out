#!/bin/bash
# takeout — your Omarchy terminal, to go.
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
UNIT="$HOME/.config/systemd/user/takeout.service"

node_bin() {
  if command -v node >/dev/null 2>&1; then command -v node
  elif command -v mise >/dev/null 2>&1; then mise which node 2>/dev/null
  fi
}
pair_url() { "$(node_bin)" "$DIR/server.js" --pair; }
is_plugin() { [[ $DIR == "$HOME/.config/omarchy/plugins/"* ]]; }
vpn_ip() { command -v tailscale >/dev/null 2>&1 && tailscale ip -4 2>/dev/null | head -1; }

usage() {
  cat <<EOF
🥡 takeout — your Omarchy terminal, to go

  takeout pair       Show the link + QR code to pair your phone
  takeout status     Is it running?
  takeout attach     Open the same session here at your desk
  takeout vpn        Reach Takeout away from home (sets up Tailscale)
  takeout restart    Restart the server (your session keeps running)
  takeout reset      New pairing token — unpairs every device
EOF
}

case "${1:-}" in
  pair)
    url=$(pair_url)
    echo
    if command -v qrencode >/dev/null 2>&1; then
      qrencode -t ansiutf8 -m 2 "$url"
    else
      echo "  (for a scannable QR code: sudo pacman -S qrencode)"
    fi
    echo
    echo "  On your home Wi-Fi, open on your phone:"
    echo "    $url"
    if ip=$(vpn_ip) && [[ -n $ip ]]; then
      echo
      echo "  Away from home (over Tailscale):"
      echo "    http://$ip:${url#http://*:}"
    fi
    echo
    echo "  Then Share → Add to Home Screen."
    echo
    ;;
  status)
    url=$(pair_url)
    base="${url%%/pair*}"
    port="${base##*:}"
    if curl -fsS -o /dev/null --max-time 2 "http://127.0.0.1:$port/manifest.webmanifest"; then
      echo "🥡 Takeout is running at $base"
      ip=$(vpn_ip || true)
      if [[ -n ${ip:-} ]]; then echo "   and over Tailscale at http://$ip:$port"; fi
    else
      echo "Takeout isn't running."
      is_plugin && echo "  Check it's enabled:  omarchy plugin list"
      exit 1
    fi
    ;;
  vpn)
    echo
    echo "🥡 Takeout works on your home Wi-Fi out of the box. To reach it from"
    echo "   anywhere, it uses Tailscale: a free, private network between your devices."
    echo
    if ! command -v tailscale >/dev/null 2>&1; then
      echo "Installing Tailscale…"
      sudo pacman -S --needed --noconfirm tailscale
    fi
    sudo systemctl enable --now tailscaled
    if ! tailscale ip -4 >/dev/null 2>&1; then
      echo
      echo "Sign in to Tailscale (a link will open, or copy it into a browser):"
      sudo tailscale up
    fi
    echo
    echo "✓ Tailscale is connected. Install the Tailscale app on your phone and sign in"
    echo "  with the same account. Then use this link from anywhere:"
    "$0" pair
    ;;
  restart)
    if [[ -f $UNIT ]]; then
      systemctl --user restart takeout.service
    else
      # The Omarchy plugin brings the server straight back.
      pkill -f "$DIR/server.js" || true
    fi
    echo "Takeout restarted."
    ;;
  attach) exec tmux new-session -A -s takeout ;;
  reset)
    rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/takeout/token"
    "$0" restart >/dev/null
    sleep 2
    echo "New token made — every device needs to pair again."
    "$0" pair
    ;;
  serve) exec bash "$DIR/start.sh" ;;
  -v|--version) "$(node_bin)" -e "console.log(require('$DIR/package.json').version)" ;;
  *) usage ;;
esac
