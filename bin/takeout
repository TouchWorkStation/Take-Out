#!/bin/bash
# takeout — your Omarchy terminal, to go.
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
PORT="${TAKEOUT_PORT:-7777}"
UNIT="$HOME/.config/systemd/user/takeout.service"

node_bin() {
  if command -v node >/dev/null 2>&1; then command -v node
  elif command -v mise >/dev/null 2>&1; then mise which node 2>/dev/null
  fi
}

is_plugin() { [[ $DIR == "$HOME/.config/omarchy/plugins/"* ]]; }

usage() {
  cat <<EOF
🥡 takeout — your Omarchy terminal, to go

  takeout pair       Show the pairing link + QR code for your phone
  takeout status     Is it running?
  takeout restart    Restart the server (your tmux session keeps running)
  takeout attach     Open the same session here at your desk
  takeout reset      New pairing token — unpairs every device
EOF
}

case "${1:-}" in
  pair)
    url=$("$(node_bin)" "$DIR/server.js" --pair)
    echo
    if command -v qrencode >/dev/null 2>&1; then
      qrencode -t ansiutf8 -m 2 "$url"
    else
      echo "  (for a scannable QR code: sudo pacman -S qrencode)"
    fi
    echo
    echo "  Open on your phone:  $url"
    echo "  Then Share → Add to Home Screen."
    echo
    ;;
  status)
    url=$("$(node_bin)" "$DIR/server.js" --pair)
    base="${url%%/pair*}"
    if curl -fsS -o /dev/null --max-time 2 "$base/manifest.webmanifest"; then
      echo "🥡 Takeout is running at $base"
    else
      echo "Takeout isn't answering at $base"
      is_plugin && echo "  Check it's enabled:  omarchy plugin list"
      exit 1
    fi
    ;;
  restart)
    if [[ -f $UNIT ]]; then
      systemctl --user restart takeout.service
    else
      # The Omarchy plugin brings the server straight back.
      pkill -f "$DIR/server.js" || true
    fi
    echo "Takeout restarted."
    ;;
  attach) exec tmux new-session -A -s takeout ;;
  reset)
    rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/takeout/token"
    "$0" restart >/dev/null
    sleep 2
    echo "New token made — every device needs to pair again."
    "$0" pair
    ;;
  serve) exec bash "$DIR/start.sh" ;;
  -v|--version) "$(node_bin)" -e "console.log(require('$DIR/package.json').version)" ;;
  *) usage ;;
esac
